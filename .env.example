# Токен Telegram-бота, полученный от @BotFather
BOT_TOKEN=

# Telegram ID администратора (число)
ADMIN_CHAT_ID=

# Юзернейм или ID канала для публикации отзывов (например, @otzivy_pirsing)
CHANNEL_ID=

# (Необязательно) Путь для постоянного хранилища, если используется Amvera
PERSISTENCE_MOUNT=/data